# OPL Fleet Cockpit Gateway production configuration with the UniFi Network API fallback.
#
# Create it with: ./scripts/opl-fleet-cockpit.sh init --profile unifi-api
# Keep the API key in ./secrets; do not paste it into this file.

OPL_FLEET_COCKPIT_IMAGE=ghcr.io/gaofeng21cn/opl-fleet-cockpit:0.1.43
OPL_FLEET_COCKPIT_DATA_VOLUME=opl-fleet-cockpit_data
SITE_NAME=Home OPL Fleet Cockpit
DISPLAY_TIME_ZONE=Etc/UTC
INSTANCE_ID=replace-me
AMBIENT_OPS_NETWORK_MODE=unifi-api

UNIFI_BASE_URL=
UNIFI_SITE=default
UNIFI_ALLOW_SELF_SIGNED=false
