# OPL Fleet Cockpit Gateway production configuration with SNMPv3 router telemetry.
#
# Create it with: ./scripts/opl-fleet-cockpit.sh init --profile snmpv3
# Keep passwords in ./secrets; do not paste them into this file.

OPL_FLEET_COCKPIT_IMAGE=ghcr.io/gaofeng21cn/opl-fleet-cockpit:0.1.43
OPL_FLEET_COCKPIT_DATA_VOLUME=opl-fleet-cockpit_data
SITE_NAME=Home OPL Fleet Cockpit
DISPLAY_TIME_ZONE=Etc/UTC
INSTANCE_ID=replace-me
AMBIENT_OPS_NETWORK_MODE=snmpv3

# Historical UNIFI_ names support any qualified IF-MIB Counter64 router.
UNIFI_SNMP_HOST=
UNIFI_SNMP_USER=
UNIFI_SNMP_INTERFACES=

# Optional: LAN interface selectors for active-neighbor estimates.
UNIFI_SNMP_CLIENT_INTERFACES=

# Optional: TCP target for latency monitoring without raw-socket privileges.
NETWORK_LATENCY_HOST=
