# OPL Fleet Cockpit Gateway production configuration.
#
# Run ./scripts/opl-fleet-cockpit.sh init to create .env with a stable INSTANCE_ID.
# Edit SITE_NAME and DISPLAY_TIME_ZONE, then validate and start. Secrets belong
# in ./secrets and must never be pasted into this file.
#
# For router telemetry, initialize with --profile snmpv3 or --profile unifi-api.

# Keep a reviewed version tag or digest. Do not use latest in production.
OPL_FLEET_COCKPIT_IMAGE=ghcr.io/gaofeng21cn/opl-fleet-cockpit:0.1.43
OPL_FLEET_COCKPIT_DATA_VOLUME=opl-fleet-cockpit_data

SITE_NAME=Home OPL Fleet Cockpit
DISPLAY_TIME_ZONE=Etc/UTC
INSTANCE_ID=replace-me
AMBIENT_OPS_NETWORK_MODE=codex-only
DISCOVERY_ENABLED=true
