{
  "schema_version": "opl.product-release.v1",
  "product_id": "opl-fleet-cockpit",
  "repository": "gaofeng21cn/opl-fleet-cockpit",
  "strategy": "daily_patch",
  "trigger": "tag",
  "tag_prefix": "v",
  "publisher_workflow": "release.yml",
  "channel": {
    "kind": "github_release"
  },
  "version_file": {
    "path": "package.json",
    "kind": "json"
  },
  "version_files": [
    {
      "path": "package.json",
      "kind": "json"
    },
    {
      "path": "package-lock.json",
      "kind": "json"
    }
  ],
  "release_paths": [
    "src",
    "server",
    "public",
    "android-kiosk",
    "ops/docker",
    "Dockerfile",
    "package.json",
    "package-lock.json",
    ".github/workflows/release.yml"
  ],
  "prepare": [
    [
      "node",
      "scripts/prepare-product-release.mjs"
    ]
  ],
  "verify": []
}
